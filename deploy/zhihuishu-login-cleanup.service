[Unit]
Description=Canvas Dashboard browser login session cleanup
After=docker.service

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/canvas-dashboard/current
EnvironmentFile=-/etc/canvas-dashboard/canvas-dashboard.env
EnvironmentFile=-/home/ubuntu/canvas-dashboard/current/release.env
ExecStart=/home/ubuntu/canvas-dashboard/current/.venv/bin/python zhihuishu_login_sessions.py --cleanup-expired
ExecStart=/home/ubuntu/canvas-dashboard/current/.venv/bin/python tongji_login_sessions.py --cleanup-expired
