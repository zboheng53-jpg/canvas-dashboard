[Unit]
Description=Canvas Dashboard Zhihuishu Worker
After=network.target canvas-dashboard.service user@1000.service
Wants=user@1000.service

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/canvas-dashboard/current
EnvironmentFile=-/etc/canvas-dashboard/canvas-dashboard.env
EnvironmentFile=-/home/ubuntu/canvas-dashboard/current/release.env
Environment=ZHIHUISHU_CHROMIUM_EXECUTABLE=/usr/bin/google-chrome-stable
Environment=XDG_RUNTIME_DIR=/run/user/1000
ExecStart=/home/ubuntu/canvas-dashboard/current/.venv/bin/python zhihuishu_worker.py --all-users
Restart=on-failure
RestartSec=30
UMask=0077
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
