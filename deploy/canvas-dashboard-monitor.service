[Unit]
Description=Canvas Dashboard resource sample
After=canvas-dashboard.service

[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/home/ubuntu/canvas-dashboard/current
EnvironmentFile=-/etc/canvas-dashboard/canvas-dashboard.env
UMask=0077
NoNewPrivileges=true
ExecStart=/home/ubuntu/canvas-dashboard/current/.venv/bin/python scripts/monitor_runtime.py
