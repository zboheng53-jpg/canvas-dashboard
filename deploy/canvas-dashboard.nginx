server {
    listen 80;
    listen [::]:80;
    server_name canvas-dashboard.xyz www.canvas-dashboard.xyz;
    client_max_body_size 8m;

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/certbot;
        default_type text/plain;
    }

    location = /_zhihuishu_vnc_auth {
        # Browser credentials must not enter access logs.
        access_log off;
        error_log /dev/null;
        internal;
        proxy_pass http://127.0.0.1:5000/api/zhihuishu/login-session-auth;
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
        proxy_set_header Cookie $http_cookie;
        proxy_set_header Authorization "";
        proxy_set_header X-Zhihuishu-Token $zhs_token;
        proxy_set_header X-Zhihuishu-Port $zhs_port;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host "";
        proxy_set_header X-Forwarded-Prefix "";
    }

    location ^~ /static/ {
        alias /home/ubuntu/canvas-dashboard/current/frontend/assets/;
        autoindex off;
        add_header Cache-Control "public, no-cache" always;
        add_header Strict-Transport-Security "max-age=31536000" always;
        gzip on;
        gzip_types text/css application/javascript application/json image/svg+xml;
        location ~ "^/static/(?<asset_path>built/(?:css|js)/.+\.[a-f0-9]{20}\.(?:css|js))$" {
            alias /home/ubuntu/canvas-dashboard/current/frontend/assets/$asset_path;
            add_header Cache-Control "public, max-age=31536000, immutable";
            add_header Strict-Transport-Security "max-age=31536000" always;
        }
    }

    location ~ "^/zhs-vnc/(?<zhs_port>61[0-9]{2})/(?<zhs_token>[A-Za-z0-9_-]{16,128})/(.*)$" {
        access_log off;
        error_log /dev/null;
        auth_request /_zhihuishu_vnc_auth;
        error_page 401 403 = @zhs_vnc_denied;
        rewrite ^/zhs-vnc/[0-9]+/[^/]+/(.*)$ /$1 break;
        proxy_pass http://127.0.0.1:$zhs_port;
        proxy_set_header Cookie "";
        proxy_set_header Authorization "";
        proxy_hide_header Set-Cookie;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_read_timeout 600s;
        proxy_send_timeout 600s;
    }

    location ~ ^/zhs-vnc/ {
        access_log off;
        error_log /dev/null;
        return 404;
    }

    location @zhs_vnc_denied {
        access_log off;
        error_log /dev/null;
        return 401;
    }

    location = /_tongji_vnc_auth {
        access_log off;
        error_log /dev/null;
        internal;
        proxy_pass http://127.0.0.1:5000/api/schedule/login-session-auth;
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
        proxy_set_header Cookie $http_cookie;
        proxy_set_header Authorization "";
        proxy_set_header X-Tongji-Token $tji_token;
        proxy_set_header X-Tongji-Port $tji_port;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host "";
        proxy_set_header X-Forwarded-Prefix "";
    }

    location ~ "^/tji-vnc/(?<tji_port>62[0-9]{2})/(?<tji_token>[A-Za-z0-9_-]{16,128})/(.*)$" {
        access_log off;
        error_log /dev/null;
        auth_request /_tongji_vnc_auth;
        error_page 401 403 = @tongji_vnc_denied;
        rewrite ^/tji-vnc/[0-9]+/[^/]+/(.*)$ /$1 break;
        proxy_pass http://127.0.0.1:$tji_port;
        proxy_set_header Cookie "";
        proxy_set_header Authorization "";
        proxy_hide_header Set-Cookie;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_read_timeout 600s;
        proxy_send_timeout 600s;
    }

    location ~ ^/tji-vnc/ {
        access_log off;
        error_log /dev/null;
        return 404;
    }

    location @tongji_vnc_denied {
        access_log off;
        error_log /dev/null;
        return 401;
    }

    location ^~ /calendar/ {
        access_log off;
        proxy_pass http://127.0.0.1:5000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host "";
        proxy_set_header X-Forwarded-Prefix "";
    }

    # Other applications sharing this host.
    location = /daily-english { return 410; }
    location ^~ /daily-english/ { return 410; }

    location = /life-list { return 410; }
    location ^~ /life-list/ { return 410; }

    location / {
        proxy_pass http://127.0.0.1:5000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host "";
        proxy_set_header X-Forwarded-Prefix "";
    }
}
