[Unit]
Description=Canvas Dashboard blank account cleanup
After=canvas-dashboard.service zhihuishu-worker.service

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/canvas-dashboard/current
EnvironmentFile=-/etc/canvas-dashboard/canvas-dashboard.env
Environment=CANVAS_DASHBOARD_MAINTENANCE_TARGET=/home/ubuntu/canvas-dashboard/maintenance
ExecStart=/home/ubuntu/canvas-dashboard/current/.venv/bin/python scripts/cleanup_blank_accounts.py
